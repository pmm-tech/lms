# Production environment for docker-compose.production.yml
# Copy to .env in this directory and set values before:
#   docker compose -f docker-compose.production.yml --env-file .env up -d

# ---------- Required ----------
# MariaDB root password (must match when creating site)
DB_PASSWORD=changeit

# ---------- Image (optional) ----------
# Default: ghcr.io/frappe/lms:stable
# Override for your registry or tag (e.g. after building from this repo)
# CUSTOM_IMAGE=ghcr.io/your-org/lms
# CUSTOM_TAG=v1.0.0

# ---------- Site (optional) ----------
# Host header used to resolve site. Default is request host.
# Set if you use a single site with a different host (e.g. for local testing).
# FRAPPE_SITE_NAME_HEADER=lms.example.com

# ---------- HTTP (optional) ----------
# Port exposed by frontend (nginx). Default 8080.
# HTTP_PUBLISH_PORT=8080

# ---------- Upstream / proxy (optional) ----------
# If behind a reverse proxy (e.g. Traefik, Nginx), set trusted proxy and header.
# UPSTREAM_REAL_IP_ADDRESS=127.0.0.1
# UPSTREAM_REAL_IP_HEADER=X-Forwarded-For
# UPSTREAM_REAL_IP_RECURSIVE=off
# PROXY_READ_TIMEOUT=120
# CLIENT_MAX_BODY_SIZE=50m

# ---------- Policies (optional) ----------
# PULL_POLICY=always
# RESTART_POLICY=unless-stopped
